ELEVENLABS_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# Model names (override if needed)
GROQ_MODEL=openai/gpt-oss-120b
ELEVENLABS_STT_MODEL=scribe_v1

# TTS: edge-tts (Microsoft, no key needed) covers 10/14 languages natively.
# Sarvam AI covers Odia and Punjabi, which edge-tts lacks — set
# SARVAM_API_KEY to enable those two; leave blank to fall back to edge-tts's
# closest-script voice for them instead. Voice/provider is picked
# automatically per answer based on the text's script (see voice.py).
# Assamese and Sanskrit have no native voice in either provider.

# Embedding model (local, multilingual — MSMARCO-XI spans Indic languages)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Index paths
INDEX_DIR=data/index

# Guardrail thresholds
MIN_RETRIEVAL_SCORE=0.55
