ELEVENLABS_API_KEY=
GROQ_API_KEY=

# Model names (override if needed)
GROQ_MODEL=openai/gpt-oss-120b
ELEVENLABS_STT_MODEL=scribe_v1

# TTS uses edge-tts (Microsoft Edge neural voices) — no key needed. Voice is
# picked automatically per answer based on the text's script (see voice.py).

# Embedding model (local, multilingual — MSMARCO-XI spans Indic languages)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Index paths
INDEX_DIR=data/index

# Guardrail thresholds
MIN_RETRIEVAL_SCORE=0.55
